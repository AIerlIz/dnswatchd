{
	"luci-app-dnswatchd": {
		"description": "Grant access to DNS Watchdog",
		"read": {
			"ubus": {
				"service": [ "list" ],
				"uci": [ "get", "show" ],
				"dnswatchd": [ "status", "probe" ]
			},
			"uci": [ "dnswatchd" ]
		},
		"write": {
			"ubus": {
				"dnswatchd": [ "once", "switch", "takeover", "rollback", "apply" ]
			},
			"uci": [ "dnswatchd" ]
		}
	}
}
