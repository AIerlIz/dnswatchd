# dnswatchd - DNS upstream watchdog
#
# Probes dnsmasq's upstream resolvers and checks that the answers land where they
# should. Switches dnsmasq's single --servers-file entry when the preferred
# upstream stops answering correctly, and switches back once it recovers.
#
# Installing this package changes NO DNS behaviour. dnsmasq is only touched by
# `dnswatchd takeover` (or the LuCI wizard), which backs everything up first and
# can be undone with `dnswatchd rollback`.

config dnswatchd 'main'
	# Master switch. Stays off until you take over.
	option enabled '0'

	# Seconds between rounds. Minimum 5.
	option interval '30'

	# Hard per-query deadline in milliseconds. A blackholed upstream costs at
	# most this much per round, no matter what the resolver library thinks.
	option probe_deadline '2000'

	# Consecutive failures before an upstream counts as down, and consecutive
	# successes before it counts as up again.
	option fail_threshold '2'
	option recover_threshold '2'

	# dnsmasq's --servers-file. Exactly one `server=` line lives here.
	# Must match dhcp.@dnsmasq[0].serversfile, which takeover sets for you.
	option servers_file '/etc/dnswatchd/servers'

	# priority: lowest `priority` number wins.
	# latency:  lowest DNS round-trip wins, by at least `latency_margin` percent.
	option selection 'priority'

	# Only used by selection='latency'.
	# How much faster a challenger must be to be considered at all (0-90).
	option latency_margin '20'
	# And for how many rounds in a row it must win.
	option latency_switch_after '2'

	# Stop probing and decide once a round has used this percentage of
	# `interval`. Keeps a pile of dead upstreams from overrunning the tick.
	option round_budget '80'

	# Log decisions without writing the servers-file.
	option dry_run '0'
	# Write decisions to syslog.
	option syslog '1'
	# Also print them to stderr (procd collects that into logread).
	option verbose '0'

# ---------------------------------------------------------------- upstreams
#
# source='static'  probe this address:port
# source='resolv'  expand the IPv4 nameservers netifd wrote to
#                  /tmp/resolv.conf.d/resolv.conf.auto (up to two), so the ISP
#                  resolvers stay available as a visible, lowest-priority
#                  fallback. takeover creates this section for you.
#
# expect_mode:
#   in      every A record must be inside expect_cidr
#   not-in  every A record must be outside expect_cidr
#   any     any A record at all is enough (expect_cidr is ignored)
#
# type='proxy'/'direct' from 0.1.x is gone; expect_mode says the same thing and
# is the value actually used.

config upstream 'primary'
	option enabled '1'
	option source 'static'
	option address '192.168.10.2'
	option port '53'
	option probe_domain 'www.google.com'
	option expect_cidr '198.18.0.0/16'
	option expect_mode 'in'
	option priority '10'

config upstream 'fallback'
	option enabled '1'
	option source 'static'
	option address '223.5.5.5'
	option port '53'
	option probe_domain 'www.baidu.com'
	option expect_cidr '198.18.0.0/16'
	option expect_mode 'not-in'
	option priority '20'
