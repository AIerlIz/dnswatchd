# dnswatchd - DNS upstream watchdog
#
# 探测 dnsmasq 的上游 DNS，验证应答内容落在预期网段内；
# 失联时把上游切到备用，恢复后自动切回。
#
# 注意：dnswatchd 只往 --servers-file 写「一个」server 行。
# 并列多个 upstream 会让 dnsmasq 并发查询，导致 fake-ip 与真实 IP 混用。

config dnswatchd 'main'
	option enabled '0'
	# 探测间隔（秒），最小 5
	option interval '30'
	# 单次 nslookup 超时（秒）
	option timeout '1'
	# 连续失败几次判定为 DOWN
	option fail_threshold '2'
	# 连续成功几次判定为 UP（回切）
	option recover_threshold '2'
	# dnsmasq 的 --servers-file；必须与 dhcp.@dnsmasq[0].serversfile 一致
	option servers_file '/tmp/dnsmasq.servers'

	# 选择策略：
	#   priority —— 按下面每个 upstream 的 priority 升序，第一个健康的胜出（默认，可预测）
	#   latency  —— 探测所有健康的 upstream，用 ping RTT 选最快的（会自动防抖）
	option selection 'priority'

	# 以下四项只在 selection='latency' 时生效
	# ping 采样次数（1-10），RTT 取 avg
	option latency_samples '3'
	# 新候选必须比当前快多少百分比才考虑切换（0-90）
	# 20 表示「至少要快 20%」，避免 1ms 的波动就把上游切来切去
	option latency_margin '20'
	# 新候选要连续几轮胜出才真的切（1-...）。设 1 = 立刻切，容易抖
	option latency_switch_after '2'

	# 只打日志不真正切换（首次部署建议先开一天）
	option dry_run '0'
	# 写 syslog
	option syslog '1'
	# 额外打到 stderr（procd 会收进 logread）
	option verbose '0'

# ---------------------------------------------------------------- 上游 1
# type=proxy  → 期望应答落在 fake-ip 段内（clash 的 198.18.0.0/16）
config upstream 'primary'
	option enabled '1'
	option type 'proxy'
	option address '192.168.10.2'
	option port '53'
	option probe_domain 'www.google.com'
	option expect_cidr '198.18.0.0/16'
	option expect_mode 'in'
	option priority '10'

# ---------------------------------------------------------------- 上游 2
# type=direct → 期望应答「不」落在 fake-ip 段内（公共 DNS 返回真实 IP）
config upstream 'fallback'
	option enabled '1'
	option type 'direct'
	option address '223.5.5.5'
	option port '53'
	option probe_domain 'www.baidu.com'
	option expect_cidr '198.18.0.0/16'
	option expect_mode 'not-in'
	option priority '20'
