#!/bin/sh
# SPDX-License-Identifier: MIT
#
# dnswatchd - DNS upstream watchdog for OpenWrt
#
# Probes dnsmasq's upstream resolvers and validates that the answers land where
# they should. When the preferred upstream stops answering correctly it rewrites
# dnsmasq's --servers-file to the next candidate and reloads it.
#
# Exactly ONE server line is ever written: dnsmasq picks among its configured
# upstreams on its own, so a second one (from `list server`, or from
# resolv.conf.auto while noresolv=0) means we no longer control which resolver
# answers — and in a fake-ip setup that is how real addresses leak in.
#
# Commands:
#   (none)      run the watch loop (this is what procd starts)
#   once        run a single round
#   status      show what is going on        [--json]
#   probe       one-shot probe               <addr> <domain> [cidr] [mode] [port]
#   takeover    hand dnsmasq over to dnswatchd
#   rollback    put dnsmasq back                [--from TIMESTAMP]
#   apply       commit staged UCI and restart  (used by the LuCI front end)

: "${DNSWATCHD_LIB:=/usr/lib/dnswatchd}"

# OpenWrt's UCI helpers; overridable so the test harness can drive the real
# entry point with its own shim instead of a live uci binary.
: "${DNSWATCHD_FUNCTIONS:=/lib/functions.sh}"
# shellcheck source=/dev/null
[ -f "$DNSWATCHD_FUNCTIONS" ] && . "$DNSWATCHD_FUNCTIONS"

# shellcheck source=/dev/null
. "$DNSWATCHD_LIB/common.sh"
# shellcheck source=/dev/null
. "$DNSWATCHD_LIB/config.sh"
# shellcheck source=/dev/null
. "$DNSWATCHD_LIB/state.sh"
# shellcheck source=/dev/null
. "$DNSWATCHD_LIB/probe.sh"
# shellcheck source=/dev/null
. "$DNSWATCHD_LIB/apply.sh"
# shellcheck source=/dev/null
. "$DNSWATCHD_LIB/select.sh"
# shellcheck source=/dev/null
. "$DNSWATCHD_LIB/takeover.sh"

usage() {
	cat >&2 <<'EOF'
usage: dnswatchd [command]

  (none)                                   run the watch loop
  once                                     run one round
  status [--json]                          show state
  probe <addr> <domain> [cidr] [mode] [port]
  switch <section>                         force a specific upstream
  takeover                                 take dnsmasq over
  rollback [--from TIMESTAMP]              give it back
  apply                                    commit staged UCI and restart
EOF
}

# ---------------------------------------------------------------- status

json_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

status_json() {
	_l="$STATE_DIR/status.list"
	ensure_state_dir
	_n=$(collect_upstreams "$_l")

	_managed=false
	[ -f "$MARKER" ] && _managed=true

	_t=$(active_target)
	_a_addr=${_t%%#*}
	_a_port=53
	case "$_t" in
		*\#*) _a_port=${_t##*#} ;;
	esac
	[ -n "$_a_addr" ] || _a_addr=""

	_enabled=0
	[ "$CFG_ENABLED" = "1" ] && _enabled=1

	printf '{"ok":true,"version":"%s","enabled":%d,"managed":%s' \
		"$VERSION" "$_enabled" "$_managed"
	printf ',"servers_file":"%s","selection":"%s"' \
		"$(json_escape "$SERVERS_FILE")" "$SELECTION"
	printf ',"active":{"section":"%s","address":"%s","port":%s}' \
		"$(active_section "$_l")" "$_a_addr" "$_a_port"
	# What dnsmasq currently looks like, so the UI can show the wizard without
	# being granted read access to /etc/config/dhcp itself.
	if command -v uci >/dev/null 2>&1; then
		printf ',"dhcp":{"servers":['

		_i=0
		_f2=1
		while [ "$_i" -lt 32 ]; do
			_s=$(uci -q get "dhcp.@dnsmasq[0].server[$_i]" 2>/dev/null)
			[ -n "$_s" ] || break
			[ "$_f2" = "1" ] || printf ','
			_f2=0
			printf '"%s"' "$(json_escape "$_s")"
			_i=$((_i + 1))
		done

		printf '],"serversfile":"%s","noresolv":"%s"}' \
			"$(json_escape "$(uci -q get dhcp.@dnsmasq[0].serversfile 2>/dev/null)")" \
			"$(json_escape "$(uci -q get dhcp.@dnsmasq[0].noresolv 2>/dev/null)")"
	fi

	printf ',"upstreams":['

	_first=1
	while IFS='|' read -r pri sec addr port dom cidr mode; do
		[ -n "$addr" ] || continue
		state_read "$sec"
		[ "$_first" = "1" ] || printf ','
		_first=0
		printf '{"section":"%s","address":"%s","port":%s,"priority":%s' \
			"$(json_escape "$sec")" "$(json_escape "$addr")" "$port" "$pri"
		printf ',"probe_domain":"%s","expect_cidr":"%s","expect_mode":"%s"' \
			"$(json_escape "$dom")" "$(json_escape "$cidr")" "$(json_escape "$mode")"
		printf ',"status":"%s","fails":%s,"oks":%s,"rtt":"%s"}' \
			"$ST_STATUS" "$ST_FAILS" "$ST_OKS" "$ST_RTT"
	done < "$_l"

	printf ']}\n'
}

status_text() {
	_l="$STATE_DIR/status.list"
	ensure_state_dir
	_n=$(collect_upstreams "$_l")

	if [ "$CFG_ENABLED" = "1" ]; then
		say "enabled:      yes"
	else
		say "enabled:      no"
	fi

	if [ -f "$MARKER" ]; then
		say "managing:     yes (since $(cat "$MARKER" 2>/dev/null))"
	else
		say "managing:     no — run 'dnswatchd takeover' to take dnsmasq over"
	fi

	say "servers-file: $SERVERS_FILE"
	_t=$(active_target)
	if [ -n "$_t" ]; then
		say "active:       $(active_section "$_l") ($_t)"
	else
		say "active:       none ($SERVERS_FILE is missing or has no server line)"
	fi
	say "selection:    $SELECTION"
	say ""

	if [ "$_n" -eq 0 ]; then
		say "no enabled upstream configured"
		return 0
	fi

	say "UPSTREAM        ADDRESS            PORT  PRI  STATUS   FAILS  OKS  RTT"

	# Sort into a file first: `< "$(sort ...)"` would treat the command output as
	# a filename. That exact mistake shipped in 0.1.x.
	sort -t'|' -k1,1n "$_l" > "$_l.sorted"

	while IFS='|' read -r pri sec addr port dom cidr mode; do
		[ -n "$addr" ] || continue
		state_read "$sec"
		printf '%-15s %-18s %-5s %-4s %-8s %-6s %-4s %s\n' \
			"$sec" "$addr" "$port" "$pri" "$ST_STATUS" "$ST_FAILS" "$ST_OKS" \
			"${ST_RTT:+${ST_RTT}ms}"
	done < "$_l.sorted"
}

# ---------------------------------------------------------------- commands

cmd_probe() {
	_p_addr=$1
	_p_dom=$2
	_p_cidr=${3:-}
	_p_mode=${4:-any}
	_p_port=${5:-53}

	[ -n "$_p_addr" ] && [ -n "$_p_dom" ] || {
		usage
		return 1
	}

	probe_one "$_p_addr" "$_p_port" "$_p_dom" "$_p_cidr" "$_p_mode"
	_rc=$?
	printf '%s\n' "$P_JSON"
	return "$_rc"
}

cmd_switch() {
	_sec=$1
	[ -n "$_sec" ] || {
		printf '{"ok":false,"error":"missing section"}\n'
		return 1
	}

	ensure_state_dir
	_l="$STATE_DIR/switch.list"
	collect_upstreams "$_l" >/dev/null

	while IFS='|' read -r pri sec2 addr port rest; do
		[ -n "$addr" ] || continue
		[ "$sec2" = "$_sec" ] || continue
		if apply_upstream "$addr" "$port"; then
			printf '{"ok":true,"section":"%s","address":"%s","port":%s}\n' \
				"$_sec" "$addr" "$port"
			return 0
		fi
		printf '{"ok":false,"error":"apply failed"}\n'
		return 1
	done < "$_l"

	printf '{"ok":false,"error":"unknown section"}\n'
	return 1
}

cmd_apply() {
	command -v uci >/dev/null 2>&1 || {
		err "uci not found"
		return 1
	}

	if ! uci -q commit dnswatchd; then
		err "uci commit dnswatchd failed"
		return 1
	fi

	if [ -x /etc/init.d/dnswatchd ]; then
		/etc/init.d/dnswatchd reload >/dev/null 2>&1 || {
			err "/etc/init.d/dnswatchd reload failed"
			return 1
		}
	else
		log "no init script; config committed but no service to reload"
	fi

	say "committed"
	return 0
}

daemon_loop() {
	load_config || {
		log "disabled in /etc/config/dnswatchd; exiting"
		exit 0
	}

	ensure_state_dir

	log "started: interval=${INTERVAL}s deadline=${PROBE_DEADLINE}ms fail=${FAIL_TH} recover=${RECOVER_TH} selection=${SELECTION} servers_file=${SERVERS_FILE}"

	trap 'log "received TERM, exiting"; exit 0' TERM INT

	while :; do
		if lock_acquire; then
			run_round
			lock_release
		else
			log "another round is in progress; skipping this tick"
		fi

		sleep "$INTERVAL" &
		wait $!
	done
}

# ---------------------------------------------------------------- dispatch

CMD=$1
[ $# -gt 0 ] && shift

case "$CMD" in
	"")
		daemon_loop
		;;

	once)
		_json=0
		[ "${1:-}" = "--json" ] && _json=1

		load_config || {
			[ "$_json" = "1" ] && printf '{"ok":false,"error":"disabled"}\n'
			exit 0
		}

		ensure_state_dir

		if ! lock_acquire; then
			[ "$_json" = "1" ] && printf '{"ok":false,"error":"busy"}\n'
			log "another round is in progress; skipping"
			exit 0
		fi

		run_round
		_rc=$?
		lock_release

		if [ "$_json" = "1" ]; then
			status_json
		else
			status_text
		fi
		exit "$_rc"
		;;

	status)
		_json=0
		[ "${1:-}" = "--json" ] && _json=1

		load_config >/dev/null 2>&1 || true
		ensure_state_dir

		if [ "$_json" = "1" ]; then
			status_json
		else
			status_text
		fi
		exit 0
		;;

	probe)
		load_config >/dev/null 2>&1 || true
		cmd_probe "$@"
		exit $?
		;;

	takeover)
		load_config >/dev/null 2>&1 || true
		takeover
		_rc=$?
		say "$TAKEOVER_MSG"
		exit "$_rc"
		;;

	switch)
		load_config >/dev/null 2>&1 || true
		cmd_switch "${1:-}"
		exit $?
		;;

	rollback)
		load_config >/dev/null 2>&1 || true
		_ts=""
		if [ "${1:-}" = "--from" ]; then
			_ts=$2
		fi
		rollback "$_ts"
		_rc=$?
		say "$TAKEOVER_MSG"
		exit "$_rc"
		;;

	apply)
		cmd_apply
		exit $?
		;;

	-h|--help|help)
		usage
		exit 0
		;;

	*)
		usage
		exit 1
		;;
esac
