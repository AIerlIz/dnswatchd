#!/bin/sh
#
# dnswatchd - DNS upstream watchdog for OpenWrt
#
# 持续探测 dnsmasq 的上游 DNS，验证应答内容是否落在预期网段内，
# 失联时把 dnsmasq 的上游从主服务器切到备用服务器，恢复后自动切回。
#
# 只用 --servers-file 里的单一 server 行（绝不并列多个），
# 因为 dnsmasq 对多个 upstream 会并发查询，会让 fake-ip 与真实 IP 混用。
#
# SPDX-License-Identifier: MIT

. /lib/functions.sh

PROG="dnswatchd"
LOG_TAG="dnswatchd"
STATE_DIR="/var/run/dnswatchd"

# 运行期配置（由 load_config 填充）
INTERVAL=30
TIMEOUT=1
FAIL_TH=2
RECOVER_TH=2
SERVERS_FILE="/tmp/dnsmasq.servers"
DRY_RUN=0
USE_SYSLOG=1
VERBOSE=0

log() {
	[ "$USE_SYSLOG" = "1" ] && logger -t "$LOG_TAG" "$*"
	[ "$VERBOSE" = "1" ] && echo "$(date '+%F %T') $*" >&2
	return 0
}

# ---------------------------------------------------------------- 网络工具

# IPv4 → 32 位整数
ip2int() {
	local a b c d
	local IFS=.
	# shellcheck disable=SC2086
	set -- $1
	[ $# -eq 4 ] || return 1
	a=$1 b=$2 c=$3 d=$4
	# 每段必须是 0-255 的十进制
	for o in $a $b $c $d; do
		case "$o" in
			''|*[!0-9]*) return 1 ;;
		esac
		[ "$o" -le 255 ] || return 1
	done
	echo $(( (a << 24) | (b << 16) | (c << 8) | d ))
}

# $1=IP  $2=CIDR  → 命中返回 0
cidr_match() {
	local ip="$1" cidr="$2"
	local net prefix ipn netn mask

	case "$ip" in
		*.*.*.*) ;;
		*) return 1 ;;
	esac

	case "$cidr" in
		*/*) ;;
		*) return 1 ;;
	esac

	net=${cidr%%/*}
	prefix=${cidr##*/}

	case "$prefix" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$prefix" -le 32 ] || return 1

	ipn=$(ip2int "$ip") || return 1
	netn=$(ip2int "$net") || return 1

	if [ "$prefix" -eq 0 ]; then
		return 0
	fi
	mask=$(( (0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF ))

	[ $(( ipn & mask )) -eq $(( netn & mask )) ]
}

# ---------------------------------------------------------------- 探针

# probe <address> <port> <domain> <cidr> <mode>
#   mode=in      → 应答必须落在 cidr 内
#   mode=not-in  → 应答必须落在 cidr 外
#   cidr 为空    → 只要能解析出 A 记录就算健康
probe() {
	local addr="$1" port="$2" domain="$3" cidr="$4" mode="$5"
	local out ip rc

	# busybox nslookup 默认用系统服务器，必须显式指定；port 非 53 时用 addr#port
	local target="$addr"
	[ -n "$port" ] && [ "$port" != "53" ] && target="${addr}#${port}"

	# -type=A 是必需的：不加的话 busybox 会优先返回 AAAA，
	# 在 IPv6 可用的链路上永远拿不到 IPv4 答案。
	out=$(nslookup -type=A -timeout="$TIMEOUT" -retry=1 "$domain" "$target" 2>/dev/null)
	rc=$?
	[ "$rc" -eq 0 ] || return 1

	# 跳过开头的 "Server: ... / Address: <server>:53" 块，只看应答部分。
	# 应答部分从第一个 "Name:" 行开始；只在其中有 A 记录（IPv4）时才算解析成功。
	ip=$(echo "$out" \
		| sed -n '/^Name:/,$p' \
		| awk '/^Address:[ \t]/{print $NF}' \
		| grep -E '^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$' \
		| tail -1)
	[ -n "$ip" ] || return 1

	[ -z "$cidr" ] && return 0

	if [ "$mode" = "not-in" ]; then
		if cidr_match "$ip" "$cidr"; then
			return 1
		fi
		return 0
	else
		if cidr_match "$ip" "$cidr"; then
			return 0
		fi
		return 1
	fi
}

# ---------------------------------------------------------------- 状态

# 每个 upstream 一个状态文件：/var/run/dnswatchd/<section>.state
# 内容：fails=N oks=M status=up|down|unknown

state_read() {
	local sf="$STATE_DIR/$1.state"
	ST_FAILS=0
	ST_OKS=0
	ST_STATUS="unknown"
	if [ -f "$sf" ]; then
		# shellcheck disable=SC1090
		. "$sf" 2>/dev/null || true
	fi
}

state_write() {
	local section="$1" sf="$STATE_DIR/$section.state"
	printf 'ST_FAILS=%s\nST_OKS=%s\nST_STATUS=%s\n' "$ST_FAILS" "$ST_OKS" "$ST_STATUS" > "$sf"
}

# check_one <section> <addr> <port> <domain> <cidr> <mode>
# 返回 0 = 该上游当前健康
check_one() {
	local section="$1"

	state_read "$section"

	if probe "$2" "$3" "$4" "$5" "$6"; then
		ST_OKS=$((ST_OKS + 1))
		ST_FAILS=0
		if [ "$ST_STATUS" != "up" ] && [ "$ST_OKS" -ge "$RECOVER_TH" ]; then
			ST_STATUS="up"
			log "upstream '$section' is UP (ok=$ST_OKS)"
		fi
	else
		ST_FAILS=$((ST_FAILS + 1))
		ST_OKS=0
		if [ "$ST_STATUS" != "down" ] && [ "$ST_FAILS" -ge "$FAIL_TH" ]; then
			ST_STATUS="down"
			log "upstream '$section' is DOWN (fail=$ST_FAILS)"
		fi
	fi

	state_write "$section"
	[ "$ST_STATUS" = "up" ]
}

# ---------------------------------------------------------------- 应用

# 写入 servers-file 并让 dnsmasq 平滑重载
apply_upstream() {
	local addr="$1"

	if [ "$DRY_RUN" = "1" ]; then
		log "DRY-RUN: would write 'server=$addr' to $SERVERS_FILE"
		return 0
	fi

	local tmp="${SERVERS_FILE}.tmp.$$"
	printf '# managed by dnswatchd - do not edit\nserver=%s\n' "$addr" > "$tmp" || {
		log "ERROR: cannot write $tmp"
		return 1
	}
	mv "$tmp" "$SERVERS_FILE" || {
		log "ERROR: cannot move $tmp to $SERVERS_FILE"
		rm -f "$tmp"
		return 1
	}

	local pid
	pid=$(pidof dnsmasq)
	if [ -n "$pid" ]; then
		kill -HUP $pid 2>/dev/null || {
			log "ERROR: HUP dnsmasq (pid $pid) failed"
			return 1
		}
		log "applied: server=$addr -> $SERVERS_FILE (dnsmasq pid $pid reloaded)"
	else
		log "WARN: dnsmasq is not running; wrote $SERVERS_FILE but did not reload"
	fi
	return 0
}

# ---------------------------------------------------------------- 采集

collect_upstreams() {
	local list="$1"

	_handle_upstream() {
		local section="$1"
		local enabled type address port domain cidr mode pri

		config_get_bool enabled "$section" enabled 1
		[ "$enabled" = "1" ] || return 0

		config_get type         "$section" type         "direct"
		config_get address      "$section" address      ""
		config_get port         "$section" port         "53"
		config_get domain       "$section" probe_domain "www.baidu.com"
		config_get cidr         "$section" expect_cidr  ""
		config_get mode         "$section" expect_mode  "in"
		config_get pri          "$section" priority     "10"

		[ -n "$address" ] || return 0

		printf '%s|%s|%s|%s|%s|%s|%s|%s\n' \
			"$pri" "$section" "$address" "$port" "$domain" "$cidr" "$mode" "$type" >> "$list"
	}

	: > "$list"
	config_foreach _handle_upstream upstream
}

# ---------------------------------------------------------------- 主循环

run_once() {
	local list="$STATE_DIR/upstreams.list"
	local prev=""
	local section addr port domain cidr mode type pri
	local chosen_section=""
	local chosen_addr=""

	[ -f "$STATE_DIR/active" ] && prev=$(cat "$STATE_DIR/active" 2>/dev/null)

	collect_upstreams "$list"

	if [ ! -s "$list" ]; then
		log "no enabled upstream configured; nothing to do"
		return 0
	fi

	# 按 priority 升序尝试，第一个健康的胜出
	while IFS='|' read -r pri section addr port domain cidr mode type; do
		[ -n "$addr" ] || continue
		if check_one "$section" "$addr" "$port" "$domain" "$cidr" "$mode"; then
			chosen_section="$section"
			chosen_addr="$addr"
			break
		fi
	done <<-EOF
	$(sort -t'|' -k1,1n "$list")
	EOF

	if [ -z "$chosen_section" ]; then
		log "no healthy upstream this round; keeping previous '${prev:-none}'"
		return 0
	fi

	if [ "$chosen_section" != "$prev" ]; then
		if apply_upstream "$chosen_addr"; then
			echo "$chosen_section" > "$STATE_DIR/active"
			log "SWITCH: ${prev:-none} -> $chosen_section ($chosen_addr)"
		fi
	else
		[ "$VERBOSE" = "1" ] && log "stable on '$chosen_section' ($chosen_addr)"
	fi
	return 0
}

load_config() {
	config_load dnswatchd

	local enabled
	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || return 1

	config_get INTERVAL     main interval          30
	config_get TIMEOUT      main timeout           1
	config_get FAIL_TH      main fail_threshold    2
	config_get RECOVER_TH   main recover_threshold 2
	config_get SERVERS_FILE main servers_file      "/tmp/dnsmasq.servers"
	config_get_bool DRY_RUN     main dry_run        0
	config_get_bool USE_SYSLOG  main syslog         1
	config_get_bool VERBOSE     main verbose        0

	case "$INTERVAL" in ''|*[!0-9]*) INTERVAL=30 ;; esac
	case "$TIMEOUT"  in ''|*[!0-9]*) TIMEOUT=1 ;; esac
	case "$FAIL_TH"  in ''|*[!0-9]*) FAIL_TH=2 ;; esac
	case "$RECOVER_TH" in ''|*[!0-9]*) RECOVER_TH=2 ;; esac

	[ "$INTERVAL" -ge 5 ] || { log "interval too small, clamping to 5"; INTERVAL=5; }
	[ "$TIMEOUT" -ge 1 ] || TIMEOUT=1
	[ "$FAIL_TH" -ge 1 ] || FAIL_TH=1
	[ "$RECOVER_TH" -ge 1 ] || RECOVER_TH=1

	return 0
}

# ---------------------------------------------------------------- 入口

case "$1" in
	once)
		# 单次运行（调试 / cron 场景）
		load_config || exit 0
		mkdir -p "$STATE_DIR"
		run_once
		exit 0
		;;
	status)
		load_config >/dev/null 2>&1 || true
		mkdir -p "$STATE_DIR"
		echo "active: $(cat "$STATE_DIR/active" 2>/dev/null || echo none)"
		echo "servers-file: $SERVERS_FILE"
		[ -f "$SERVERS_FILE" ] && sed 's/^/  /' "$SERVERS_FILE"
		for f in "$STATE_DIR"/*.state; do
			[ -f "$f" ] || continue
			echo "--- $(basename "$f" .state) ---"
			sed -e 's/^ST_FAILS=/  fails:  /' \
			    -e 's/^ST_OKS=/  oks:    /' \
			    -e 's/^ST_STATUS=/  status: /' "$f"
		done
		exit 0
		;;
	probe)
		# 手工探测：dnswatchd probe <addr> <domain> [cidr] [mode]
		load_config >/dev/null 2>&1 || true
		if probe "$2" "53" "$3" "$4" "${5:-in}"; then
			echo "OK"
			exit 0
		else
			echo "FAIL"
			exit 1
		fi
		;;
	"")
		;;
	*)
		echo "usage: $PROG [once|status|probe <addr> <domain> [cidr] [mode]]" >&2
		exit 1
		;;
esac

load_config || {
	log "disabled by uci (dnswatchd.main.enabled=0); exiting"
	exit 0
}

mkdir -p "$STATE_DIR"

log "started: interval=${INTERVAL}s timeout=${TIMEOUT}s fail=${FAIL_TH} recover=${RECOVER_TH} servers_file=${SERVERS_FILE}"

trap 'log "received TERM, exiting"; exit 0' TERM INT

while true; do
	run_once
	sleep "$INTERVAL" &
	wait $!
done
