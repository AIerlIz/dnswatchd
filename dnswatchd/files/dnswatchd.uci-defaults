#!/bin/sh
#
# dnswatchd - uci-defaults
#
# Deliberately does nothing to your DNS configuration.
#
# 0.1.x deleted `dhcp.@dnsmasq[0].server` here and pointed dnsmasq at a
# servers-file that only a daemon — disabled by default — would ever update.
# Installing the package could break DNS on a router that had done nothing
# wrong. That whole migration lives in `dnswatchd takeover` now, where it is
# explicit, backed up, and reversible.
#
# SPDX-License-Identifier: MIT

mkdir -p /etc/dnswatchd

[ -f /etc/config/dnswatchd ] || exit 0

logger -t dnswatchd "installed; DNS untouched. Run 'dnswatchd takeover' or open LuCI > Services > DNS Watchdog when ready." 2>/dev/null

exit 0
