#!/bin/sh /etc/rc.common
#
# dnswatchd - DNS upstream watchdog for OpenWrt
# SPDX-License-Identifier: MIT

USE_PROCD=1
START=95
STOP=10

start_service() {
	local enabled
	config_load dnswatchd
	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || {
		logger -t dnswatchd "disabled in /etc/config/dnswatchd, not starting"
		return 0
	}

	procd_open_instance
	procd_set_param command /usr/sbin/dnswatchd
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="1024 1024"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "dnswatchd"
}

# 兼容 /etc/init.d/dnswatchd reload：改完 UCI 后重启实例
reload_service() {
	stop
	start
}
