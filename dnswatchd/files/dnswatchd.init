#!/bin/sh /etc/rc.common
#
# dnswatchd - DNS upstream watchdog for OpenWrt
# SPDX-License-Identifier: MIT

USE_PROCD=1
START=95
STOP=10

start_service() {
	local enabled

	config_load dnswatchd
	config_get_bool enabled main enabled 0

	[ "$enabled" = "1" ] || {
		logger -t dnswatchd "disabled in /etc/config/dnswatchd, not starting" 2>/dev/null
		return 0
	}

	# Running without takeover is harmless but pointless: dnsmasq does not read
	# the servers-file yet, so say so instead of silently doing nothing.
	if [ ! -f /etc/dnswatchd/takenover ]; then
		logger -t dnswatchd "not managing dnsmasq yet; run 'dnswatchd takeover' (or the LuCI wizard)" 2>/dev/null
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/dnswatchd
	procd_set_param respawn 3600 5 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="1024 1024"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "dnswatchd"
}

# Config changes are picked up by a full restart: the in-memory counters are
# cheap to rebuild and a stale threshold is worse than a re-probe.
reload_service() {
	stop
	start
}
